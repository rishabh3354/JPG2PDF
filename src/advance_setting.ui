       </property>
      </widget>
     </item>
     <item row="0" column="1">
      <widget class="QComboBox" name="compression">
       <property name="toolTip">
        <string>Makes the PDF file smaller. Higher settings give smaller files with slightly lower picture quality.</string>
       </property>
       <item>
        <property name="text">
         <string>Off (best quality)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Low (high quality, a bit smaller)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>Medium (good quality, much smaller)</string>
        </property>
       </item>
       <item>
        <property name="text">
         <string>High (smallest file)</string>
        </property>
       </item>
      </widget>
     </item>
     <item row="1" column="0" colspan="2">
      <widget class="QLabel" name="compression_info">
       <property name="text">
        <string>Great for photos and big screenshots. Pages keep the same size. See-through areas turn white.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
</item>
