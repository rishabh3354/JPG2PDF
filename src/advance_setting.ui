   <string>QCheckBox::indicator { width: 20px;height:20px };</string>
  </property>
  <property name="toolTip">
   <string>Each image is saved as its own PDF with the same name as the image file. A TIFF file with several pages becomes one PDF with all its pages.</string>
  </property>
  <property name="text">
   <string>Make a separate PDF for each image (photo.tif → photo.pdf)</string>
  </property>
 </widget>
</item>

