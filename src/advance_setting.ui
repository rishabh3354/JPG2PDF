   </sizepolicy>
  </property>
  <property name="title">
   <string>CLEAN UP SCANS</string>
  </property>
  <layout class="QVBoxLayout" name="v_groupBox_cleanup">
   <item>
    <layout class="QGridLayout" name="g_groupBox_cleanup">
     <item row="0" column="0">
      <widget class="QCheckBox" name="straighten">
       <property name="styleSheet">
        <string>QCheckBox::indicator { width: 20px;height:20px };</string>
       </property>
       <property name="toolTip">
        <string>Turns slightly crooked scans and photos of documents so the text lines are level</string>
       </property>
       <property name="text">
        <string>Straighten tilted pages</string>
       </property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QCheckBox" name="trim_borders">
       <property name="styleSheet">
        <string>QCheckBox::indicator { width: 20px;height:20px };</string>
       </property>
       <property name="toolTip">
        <string>Removes plain white margins and dark scanner edges around the page</string>
       </property>
       <property name="text">
        <string>Cut off empty or dark borders</string>
       </property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QCheckBox" name="contrast">
       <property name="styleSheet">
        <string>QCheckBox::indicator { width: 20px;height:20px };</string>
       </property>
       <property name="toolTip">
        <string>Makes faded or grey scans darker and crisper</string>
       </property>
       <property name="text">
        <string>Make text clearer (more contrast)</string>
       </property>
      </widget>
     </item>
     <item row="3" column="0">
      <widget class="QLabel" name="cleanup_info">
       <property name="text">
        <string>Best for scanned documents and receipts. Applies to all images in the PDF.</string>
       </property>
       <property name="wordWrap">
        <bool>true</bool>
       </property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
</item>

